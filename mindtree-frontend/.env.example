# Same-origin deployment or Vite dev proxy can leave this empty.
# If the backend is deployed separately, set it to the backend origin, for example:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Vite dev proxy target. Use this when your local backend is not on port 3000.
# VITE_DEV_PROXY_TARGET=http://localhost:3001
VITE_DEV_PROXY_TARGET=
