# ================================
# MindTree 后端配置
# ================================

# 选择模型供应商：xunfei / deepseek / custom
# - xunfei：继续用原来的讯飞千问接口
# - deepseek：使用 DeepSeek 官方 OpenAI-compatible API
# - custom：任意兼容 OpenAI Chat Completions 的第三方接口
AI_PROVIDER=deepseek

# ================================
# DeepSeek 配置
# 官方 OpenAI Format Base URL: https://api.deepseek.com
# 常用模型：deepseek-v4-flash / deepseek-v4-pro
# ================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_PATH=/chat/completions

# ================================
# 讯飞千问配置（如果 AI_PROVIDER=xunfei，就填这里）
# ================================
XUNFEI_API_KEY=your-xunfei-api-key
XUNFEI_MODEL=xop3qwen1b7
XUNFEI_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com
XUNFEI_API_PATH=/v2/chat/completions

# ================================
# 自定义 OpenAI-compatible 配置（如果 AI_PROVIDER=custom，就填这里）
# ================================
OPENAI_COMPATIBLE_API_KEY=your-api-key
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_PATH=/chat/completions

# 后端端口，默认 3000
PORT=3000

# 允许访问后端的前端源。开发环境可用 *，线上建议改成你的前端域名
CORS_ORIGIN=*

# 请求体大小限制，默认 1MB
MAX_BODY_BYTES=1048576

# 单个 Markdown 文件索引大小上限，默认 2MB
OBSIDIAN_MAX_FILE_BYTES=2097152

# 心理复盘写回 Obsidian 库内的目录，默认 MindTree Reviews
OBSIDIAN_REVIEW_DIR=MindTree Reviews
