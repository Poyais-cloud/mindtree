# 讯飞星火大模型 API Key
# 获取地址：https://training.xfyun.cn/modelService
# 控制台 -> 模型服务 -> 应用管理里复制
XUNFEI_API_KEY=your api key


# 服务端口，默认 3000
PORT=3000

# 允许访问后端的前端源。开发环境可用 *，线上建议改成你的前端域名
CORS_ORIGIN=*

# 请求体大小限制，默认 1MB
MAX_BODY_BYTES=1048576

# 单个知识库文件大小限制，默认 2MB
MAX_KNOWLEDGE_FILE_BYTES=2097152

# 使用的模型名
# 可选：xop3qwen1b7 (Qwen 1.7B) 
MODEL=xop3qwen1b7

# 可选：如果希望知识库使用向量相似度检索，配置 DashScope / Qwen embedding。
# 不配置时会自动使用本地关键词检索兜底。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v3
